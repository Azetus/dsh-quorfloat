{
  "name": "dsh-quorfloat",
  "version": "0.1.4",
  "private": true,
  "description": "System-level floating conversation window for DeepSeek Harness (host plugin half)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azetus/dsh-quorfloat.git"
  },
  "homepage": "https://github.com/Azetus/dsh-quorfloat#readme",
  "bugs": {
    "url": "https://github.com/Azetus/dsh-quorfloat/issues"
  },
  "quorfloat": {
    "platformPackages": {
      "darwin": "@azetus/dsh-quorfloat-darwin",
      "win32-x64": "@azetus/dsh-quorfloat-win32-x64"
    }
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "README_EN.md",
    "LICENSE",
    "assets"
  ],
  "scripts": {
    "toolchain": "npm install --prefix .tooling --cache .tooling/.npm-cache --no-audit --no-fund typescript@5.9.3 @types/node@22",
    "frontend:install": "npm --prefix quorfloat/frontend install --no-audit --no-fund",
    "build": "node scripts/release.mjs",
    "build:npm": "node scripts/release-npm.mjs",
    "ci:test": "node scripts/ci.mjs test",
    "release:publish": "node scripts/publish-npm.mjs",
    "build:local": "npm run build:plugin && npm run build:sidecar",
    "build:plugin": "npm run toolchain --silent && node scripts/tsc.mjs -p tsconfig.json && node scripts/build-client.mjs",
    "build:frontend": "npm --prefix quorfloat/frontend run build",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "typecheck": "node scripts/tsc.mjs -p tsconfig.json --noEmit",
    "test": "npm run build:local --silent && node --test --test-timeout=30000 \"tests/*.test.mjs\"",
    "test:only": "node --test --test-timeout=30000 \"tests/*.test.mjs\"",
    "test:frontend": "npm --prefix quorfloat/frontend test",
    "contract:extract": "node tests/fixtures/extract-harness-contract.mjs",
    "dev": "node scripts/dev.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  }
}
